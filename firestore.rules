rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasEmail() {
      return request.auth != null &&
        'token' in request.auth &&
        'email' in request.auth.token &&
        request.auth.token.email != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (hasEmail() && (request.auth.token.email == 'admin@attendly.edu' || request.auth.token.email.matches('.*admin.*'))) ||
        request.auth.uid == 'admin' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    function isFaculty() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/faculty/$(request.auth.uid)))
      );
    }

    function isStudent() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/students/$(request.auth.uid)))
      );
    }

    // Public / general read & write for portal functionality
    match /admins/{adminId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /students/{studentId} {
      allow read, write: if true;
    }

    match /faculty/{facultyId} {
      allow read, write: if true;
    }

    match /programs/{id} { allow read, write: if true; }
    match /semesters/{id} { allow read, write: if true; }
    match /academicYears/{id} { allow read, write: if true; }
    match /sections/{id} { allow read, write: if true; }
    match /subjects/{id} { allow read, write: if true; }
    match /timetable/{id} { allow read, write: if true; }
    match /facultyAssignments/{id} { allow read, write: if true; }

    match /attendanceSessions/{sessionId} {
      allow read, write: if true;
    }

    match /attendanceRecords/{recordId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isStudent();
    }

    match /assignments/{assignmentId} {
      allow read, write: if true;
    }

    match /assignmentSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isStudent() || (
        request.resource.data.studentId == resource.data.studentId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['marks', 'feedback'])
      );
    }

    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    match /quizAttempts/{attemptId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isStudent();
    }

    match /codingTests/{testId} {
      allow read, write: if true;
    }

    match /codingSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if !isStudent();
    }

    match /participationMarks/{markId} {
      allow read: if true;
      allow write: if !isStudent();
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /systemSettings/{id} {
      allow read, write: if true;
    }

    match /courseMaterials/{materialId} {
      allow read, write: if true;
    }

    match /groupProjects/{projectId} {
      allow read, write: if true;
    }

    match /photoChangeRequests/{requestId} {
      allow read, write: if true;
    }

    match /attendanceReviewRequests/{requestId} {
      allow read, write: if true;
    }

    match /studentPhotos/{uid} {
      allow read, write: if true;
    }

    match /_connection_test_/{docId} {
      allow read, write: if true;
    }
  }
}
